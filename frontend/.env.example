# Copy to .env.local for local development

# Canonical public origin — used for sitemap, canonical URLs, OG, JSON-LD
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NEXT_PUBLIC_API_URL="http://localhost:4000"
# Optional — forces header/footer “Shop” to this PDP slug when set (otherwise uses /v1/products/featured)
NEXT_PUBLIC_SHOP_PRODUCT_SLUG=""
# Server-side fetch (SSR admin auth); usually same host as API
API_INTERNAL_URL="http://127.0.0.1:4000"
# Browser rewrites /v1 → API (see next.config.mjs); also used as SSR fallback when API_INTERNAL_URL unset
API_PROXY_TARGET="http://127.0.0.1:4000"
# Meta Pixel — falls back to DEFAULT_META_PIXEL_ID in lib/meta-pixel-config.ts; Admin → Settings → Meta ads overrides both
NEXT_PUBLIC_META_PIXEL_ID="1408377107972075"
# Optional — legacy preload gate; checkout loads Razorpay JS automatically and uses the key from POST /v1/orders
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
